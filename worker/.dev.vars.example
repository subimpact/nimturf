# Local development secrets. Copy to worker/.dev.vars (which is gitignored).

# HMAC key for session tokens. Any long random string; sign-in refuses to work
# with anything shorter than 16 characters rather than using a weak default.
SESSION_SECRET=change-me-to-a-long-random-string

# Nimiq address that receives deed payments. Deeds are simply not offered when
# this is unset, and the rest of the game works normally.
TREASURY_ADDRESS=

# Nimiq Albatross JSON-RPC endpoint, used to confirm deed transactions on
# chain. A public community node works for development.
# NIMIQ_RPC_URL=https://rpc.nimiqwatch.com
NIMIQ_RPC_URL=

# Only needed when the client is served from a different origin than the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
