{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers"
    ],
    "baseUrl": ".",
    "paths": {
      "@nimturf/shared": [
        "../packages/shared/src/index.ts"
      ],
      "@nimturf/shared/*": [
        "../packages/shared/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}